{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Mavergreen/shipyard"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^UPSTREAM_VERSION$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\S+)\\s*$"
      ],
      "depNameTemplate": "ziglang/zig",
      "datasourceTemplate": "gitea-tags",
      "registryUrlTemplate": "https://codeberg.org"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^components/clang/version$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\S+)\\s*$"
      ],
      "depNameTemplate": "Mavergreen/clang-22",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-mavericks\\.(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^components/longboat/version$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\S+)\\s*$"
      ],
      "depNameTemplate": "Mavergreen/longboat",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<major>\\d{8})\\.(?<minor>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^components/ca-certs/version$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\S+)\\s*$"
      ],
      "depNameTemplate": "Mavergreen/ca-certs",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-mavericks\\.(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "clang-22 links the pinned Recaulk in place of its own, so the two must move together: since 22.1.8-mavericks.5 clang-22 carries no libc++abi.a and needs Recaulk 20261019.1 or later, and that Recaulk's __cxa back-fills collide with an older clang-22's libc++abi.a",
      "matchDepNames": [
        "Mavergreen/clang-22",
        "recaulk"
      ],
      "groupName": "clang-22 and Recaulk"
    }
  ]
}
