+/// The LLVM targets this compiler's LLVM libraries were built with, as `llvm-config --targets-built`
+/// prints them; empty means all of LLVM's default targets.
+pub const llvm_targets: []const u8 = if (@hasDecl(build_options, "llvm_targets")) build_options.llvm_targets else "";
+
+/// Whether the LLVM target `name` (LLVM's spelling, such as "AArch64") was built.
+pub fn llvmTargetBuilt(name: []const u8) bool {
+    if (llvm_targets.len == 0) return true;
+    var it = std.mem.tokenizeScalar(u8, llvm_targets, ' ');
+    while (it.next()) |built| {
+        if (std.mem.eql(u8, built, name)) return true;
+    }
+    return false;
+}
+
+/// Whether the LLVM backend for `arch` was built into this compiler's LLVM libraries.
+pub fn llvmBackendBuilt(arch: std.Target.Cpu.Arch) bool {
+    return switch (arch) {
+        .aarch64, .aarch64_be => llvmTargetBuilt("AArch64"),
+        .amdgcn => llvmTargetBuilt("AMDGPU"),
+        .arm, .armeb, .thumb, .thumbeb => llvmTargetBuilt("ARM"),
+        .avr => llvmTargetBuilt("AVR"),
+        .bpfel, .bpfeb => llvmTargetBuilt("BPF"),
+        .hexagon => llvmTargetBuilt("Hexagon"),
+        .lanai => llvmTargetBuilt("Lanai"),
+        .loongarch32, .loongarch64 => llvmTargetBuilt("LoongArch"),
+        .mips, .mipsel, .mips64, .mips64el => llvmTargetBuilt("Mips"),
+        .msp430 => llvmTargetBuilt("MSP430"),
+        .nvptx, .nvptx64 => llvmTargetBuilt("NVPTX"),
+        .powerpc, .powerpcle, .powerpc64, .powerpc64le => llvmTargetBuilt("PowerPC"),
+        .riscv32, .riscv32be, .riscv64, .riscv64be => llvmTargetBuilt("RISCV"),
+        .spirv32, .spirv64 => llvmTargetBuilt("SPIRV"),
+        .sparc, .sparc64 => llvmTargetBuilt("Sparc"),
+        .s390x => llvmTargetBuilt("SystemZ"),
+        .ve => llvmTargetBuilt("VE"),
+        .wasm32, .wasm64 => llvmTargetBuilt("WebAssembly"),
+        .x86, .x86_64 => llvmTargetBuilt("X86"),
+        .xcore => llvmTargetBuilt("XCore"),
+        else => true,
+    };
+}
