+/// LLVM's default targets, in the spelling of `llvm-config --targets-built` and of their libraries' names.
+const llvm_default_targets = [_][]const u8{
+    "AArch64", "AMDGPU",  "ARM",   "AVR",   "BPF",   "Hexagon", "Lanai", "LoongArch",   "Mips", "MSP430",
+    "NVPTX",   "PowerPC", "RISCV", "SPIRV", "Sparc", "SystemZ", "VE",    "WebAssembly", "X86",  "XCore",
+};
+
+/// Whether the LLVM library `lib_name` is built, given `llvm_targets` (space-separated; empty means all):
+/// a target's libraries (`LLVM<Target><Component>`) only when that target is.
+fn llvmLibBuilt(lib_name: []const u8, llvm_targets: []const u8) bool {
+    if (llvm_targets.len == 0 or !mem.startsWith(u8, lib_name, "LLVM")) return true;
+    const rest = lib_name["LLVM".len..];
+    for (llvm_default_targets) |t| {
+        if (!mem.startsWith(u8, rest, t)) continue;
+        if (rest.len > t.len and !std.ascii.isUpper(rest[t.len])) continue;
+        var it = mem.tokenizeScalar(u8, llvm_targets, ' ');
+        while (it.next()) |built| {
+            if (mem.eql(u8, built, t)) return true;
+        }
+        return false;
+    }
+    return true;
+}
