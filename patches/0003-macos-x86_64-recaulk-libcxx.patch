+/// A Mac OS X 10.9 executable or dylib takes, after every other input, clang-22's libc++ (for
+/// C++), Recaulk's back-fills of what 10.9's libSystem lacks, then the system's libc++abi and
+/// the system libraries Recaulk calls into, in clang22's order. Both archives load hidden, so a
+/// dylib exports neither. Static libraries and objects take none: their consumer links Recaulk.
+fn loadMavericksRuntime(self: *MachO) !void {
+    const comp = self.base.comp;
+    if (!mavergreen.isMavericksTarget(&comp.root_mod.resolved_target.result) or !comp.config.link_libc) return;
+    const arena = comp.arena;
+    if (comp.config.link_libcpp) {
+        try self.loadMavericksArchive(try mavergreen.dir(arena, comp.dirs, &.{ "x86_64-macos", "libc++.a" }));
+    }
+    try self.loadMavericksArchive(try mavergreen.dir(arena, comp.dirs, &.{ "x86_64-macos", "librecaulk.a" }));
+    const sdk = comp.sysroot orelse return;
+    try self.loadMavericksDylib(sdk, "usr/lib/libc++abi", comp.config.link_libcpp);
+    for (mavergreen.recaulk_dependencies) |stem| try self.loadMavericksDylib(sdk, stem, false);
+}
+
+fn loadMavericksArchive(self: *MachO, path: []const u8) !void {
+    const comp = self.base.comp;
+    const file = Io.Dir.cwd().openFile(comp.io, path, .{}) catch |err|
+        return comp.link_diags.addError("this Zig for Mavericks is missing {s}: {t}", .{ path, err });
+    self.classifyInputFile(.{ .archive = .{
+        .path = .initCwd(path),
+        .file = file,
+        .must_link = false,
+        .hidden = true,
+        // Zig links as with -ObjC, which would load Recaulk's Objective-C members, and with them
+        // libobjc, into every program; clang22 links without it.
+        .toolchain_runtime = true,
+    } }) catch |err| comp.link_diags.addParseError(.initCwd(path), "failed to read input file: {t}", .{err});
+}
+
+/// `explicit` is a library the link names, kept whether or not anything references it; the
+/// others are kept only when referenced.
+fn loadMavericksDylib(self: *MachO, sdk: []const u8, stem: []const u8, explicit: bool) !void {
+    const comp = self.base.comp;
+    const io = comp.io;
+    for ([_][]const u8{ ".tbd", ".dylib", "" }) |ext| {
+        const path = try std.fmt.allocPrint(comp.arena, "{s}" ++ fs.path.sep_str ++ "{s}{s}", .{ sdk, stem, ext });
+        const file = Io.Dir.cwd().openFile(io, path, .{}) catch |err| switch (err) {
+            error.FileNotFound => continue,
+            else => |e| return comp.link_diags.addParseError(.initCwd(path), "failed to open library: {t}", .{e}),
+        };
+        const fh = try self.addFileHandle(file);
+        const lib: SystemLib = .{ .path = .initCwd(path) };
+        if (mem.eql(u8, ext, ".tbd")) {
+            _ = try self.addTbd(lib, explicit, fh);
+        } else {
+            const fat_arch = try self.parseFatFile(file, lib.path);
+            _ = try self.addDylib(lib, explicit, fh, if (fat_arch) |fa| fa.offset else 0);
+        }
+        return;
+    }
+}
