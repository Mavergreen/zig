+/// `<prefix>/lib/mavergreen`, beside this Zig's `<prefix>/lib/zig`: Recaulk, clang-22's libc++ and
+/// their headers, the pieces a Mac OS X 10.9 program takes from clang22's toolchain.
+pub fn dir(arena: Allocator, dirs: std.zig.Directories, sub_path: []const []const u8) Allocator.Error![]const u8 {
+    var parts: std.ArrayList([]const u8) = .empty;
+    try parts.appendSlice(arena, &.{ dirs.cwd, dirs.zig_lib.path orelse ".", "..", "mavergreen" });
+    try parts.appendSlice(arena, sub_path);
+    return std.fs.path.resolveAlloc(arena, parts.items);
+}
