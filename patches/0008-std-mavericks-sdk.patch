+/// An x86_64 macOS target whose deployment floor is below 11.0, a Mac OS X 10.9 target.
+/// The same rule as the compiler's `isMavericksTarget` in src/mavergreen.zig (patch 0002).
+pub fn isMavericksTarget(target: *const Target) bool {
+    if (target.os.tag != .macos or target.cpu.arch != .x86_64) return false;
+    return target.os.version_range.semver.min.order(.{ .major = 11, .minor = 0, .patch = 0 }) == .lt;
+}
+
+/// Longboat's Mac OS X 10.9 SDK, which every Zig for Mavericks requires.
+pub const mavericks_sdk_path = "/usr/local/mavergreen/sdk109/SDKs/MacOSX10.9.sdk";
+
+/// The SDK of a Mac OS X 10.9 target, as the compiler chooses it: `sdkroot` when non-empty, else
+/// Longboat's 10.9 SDK, else null. Never xcrun's, which is empty on 10.9 and a newer SDK elsewhere.
+/// Caller owns the memory.
+pub fn mavericksSdk(gpa: Allocator, io: Io, sdkroot: ?[]const u8) ?[]const u8 {
+    if (sdkroot) |s| if (s.len != 0) return gpa.dupe(u8, s) catch null;
+    Io.Dir.accessAbsolute(io, mavericks_sdk_path, .{}) catch return null;
+    return gpa.dupe(u8, mavericks_sdk_path) catch null;
+}
