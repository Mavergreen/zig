+//! Zig for Mavericks: what this Zig does differently for Mac OS X 10.9 targets.
+//! The Mavergreen zig repo's PORT.md explains each piece.
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const Io = std.Io;
+const LibCInstallation = std.zig.LibCInstallation;
+
+/// An x86_64 macOS target whose deployment floor is below 11.0: a Mac OS X 10.9 target.
+/// An explicit 11.0 or later, and every other arch, is upstream's.
+pub fn isMavericksTarget(target: *const std.Target) bool {
+    if (target.os.tag != .macos or target.cpu.arch != .x86_64) return false;
+    return target.os.version_range.semver.min.order(.{ .major = 11, .minor = 0, .patch = 0 }) == .lt;
+}
+
+pub const sdk_missing_message = "the Mac OS X 10.9 SDK is not installed; run: sudo longboat sdk install 10.9";
+
+/// The SDK a Mac OS X 10.9 target compiles and links against: `sysroot` when given, else
+/// `SDKROOT` when set, else the installed `<prefix>/SDKs/MacOSX10.9.sdk` beside this Zig's
+/// `<prefix>/lib/zig`. Null for any other target. Never asks xcrun: the Command Line Tools'
+/// answer is empty on 10.9, and Xcode's is a newer SDK.
+pub fn sdkDir(
+    arena: Allocator,
+    io: Io,
+    dirs: std.zig.Directories,
+    target: *const std.Target,
+    sysroot: ?[]const u8,
+    environ_map: *const std.process.Environ.Map,
+) error{ OutOfMemory, MavericksSdkMissing }!?[]const u8 {
+    if (!isMavericksTarget(target)) return null;
+    if (sysroot) |s| return s;
+    if (environ_map.get("SDKROOT")) |s| if (s.len != 0) return s;
+    const sdk = try std.fs.path.resolveAlloc(arena, &.{
+        dirs.cwd, dirs.zig_lib.path orelse ".", "..", "..", "SDKs", "MacOSX10.9.sdk",
+    });
+    // Longboat's sdk109 is Apple's 10.9 SDK, with SDKSettings.plist and no SDKSettings.json. An
+    // SDK whose settings name no version for the linker to record is not installed for this
+    // Zig's purposes.
+    const json = try std.fs.path.join(arena, &.{ sdk, "SDKSettings.json" });
+    if (Io.Dir.cwd().access(io, json, .{})) |_| return sdk else |_| {}
+    const plist = try std.fs.path.join(arena, &.{ sdk, "SDKSettings.plist" });
+    _ = (sdkPlistVersion(arena, io, Io.Dir.cwd(), plist) catch |err| switch (err) {
+        error.OutOfMemory => |e| return e,
+        error.Canceled => return error.MavericksSdkMissing,
+    }) orelse return error.MavericksSdkMissing;
+    return sdk;
+}
+
+/// The `Version` of the SDKSettings.plist at `sub_path`, as `plistSdkVersion` reads it; null when
+/// the file cannot be read or is over 64 KiB.
+pub fn sdkPlistVersion(arena: Allocator, io: Io, root: Io.Dir, sub_path: []const u8) error{ OutOfMemory, Canceled }!?[]const u8 {
+    const contents = root.readFileAlloc(io, sub_path, arena, .limited(64 * 1024)) catch |err| switch (err) {
+        error.OutOfMemory, error.Canceled => |e| return e,
+        else => return null,
+    };
+    return plistSdkVersion(contents);
+}
+
+/// The SDK version an XML SDKSettings.plist names: the `<string>` after the one `<key>Version</key>`
+/// of its top-level dictionary, numbers such as `10.9` or `10.9.5`. A strict text scan rather than a
+/// plist parser, for the plists Apple's SDKs carry: null for anything else (a binary plist, a
+/// comment left open, CDATA, unbalanced dictionaries, no top-level `Version` or more than one, or a
+/// value that is not such a `<string>`), so an SDK whose version cannot be known is refused.
+pub fn plistSdkVersion(contents: []const u8) ?[]const u8 {
+    const mem = std.mem;
+    if (!mem.startsWith(u8, contents, "<?xml ")) return null;
+    if (mem.indexOf(u8, contents, "<plist version=\"1.0\">") == null) return null;
+    const key = "<key>Version</key>";
+    var depth: usize = 0;
+    var version: ?[]const u8 = null;
+    var i: usize = 0;
+    while (mem.indexOfScalarPos(u8, contents, i, '<')) |lt| {
+        const rest = contents[lt..];
+        if (mem.startsWith(u8, rest, "<!--")) {
+            i = (mem.indexOfPos(u8, contents, lt + 4, "-->") orelse return null) + 3;
+        } else if (mem.startsWith(u8, rest, "<![CDATA[")) {
+            return null;
+        } else if (mem.startsWith(u8, rest, "<dict>")) {
+            depth += 1;
+            i = lt + "<dict>".len;
+        } else if (mem.startsWith(u8, rest, "</dict>")) {
+            if (depth == 0) return null;
+            depth -= 1;
+            i = lt + "</dict>".len;
+        } else if (mem.startsWith(u8, rest, key)) {
+            i = lt + key.len;
+            if (depth != 1) continue;
+            if (version != null) return null;
+            const value = mem.trimStart(u8, contents[i..], " \t\r\n");
+            if (!mem.startsWith(u8, value, "<string>")) return null;
+            const len = mem.indexOf(u8, value["<string>".len..], "</string>") orelse return null;
+            version = value["<string>".len..][0..len];
+            i = contents.len - value.len + "<string>".len + len + "</string>".len;
+        } else {
+            i = lt + 1;
+        }
+    }
+    if (depth != 0) return null;
+    const v = version orelse return null;
+    var parts: usize = 0;
+    var it = mem.splitScalar(u8, v, '.');
+    while (it.next()) |part| {
+        parts += 1;
+        if (part.len == 0 or part.len > 5) return null;
+        for (part) |c| if (!std.ascii.isDigit(c)) return null;
+    }
+    return if (parts == 2 or parts == 3) v else null;
+}
+
+/// The libc installation of a Mac OS X 10.9 target: its SDK's headers, frameworks and libSystem.
+pub fn libcInstallation(
+    arena: Allocator,
+    io: Io,
+    dirs: std.zig.Directories,
+    target: *const std.Target,
+    sysroot: ?[]const u8,
+    environ_map: *const std.process.Environ.Map,
+) error{ OutOfMemory, MavericksSdkMissing }!?*const LibCInstallation {
+    const sdk = (try sdkDir(arena, io, dirs, target, sysroot, environ_map)) orelse return null;
+    const include = try std.fs.path.join(arena, &.{ sdk, "usr", "include" });
+    const lci = try arena.create(LibCInstallation);
+    lci.* = .{
+        .include_dir = include,
+        .sys_include_dir = include,
+        .crt_dir = try std.fs.path.join(arena, &.{ sdk, "usr", "lib" }),
+        .darwin_sdk_dir = sdk,
+    };
+    return lci;
+}
