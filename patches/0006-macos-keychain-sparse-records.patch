+/// Adds the certificates of the keychain file `bytes` to `cb`, as rescanMac does for each keychain it reads.
+pub fn addKeychain(cb: *Bundle, gpa: Allocator, bytes: []const u8, now_sec: i64) !void {
+    var reader: Io.Reader = .fixed(bytes);
+    scanReader(cb, gpa, &reader, now_sec) catch |err| switch (err) {
+        error.ReadFailed => unreachable, // prebuffered
+        else => |e| return e,
+    };
+}
