+/// Mavergreen's ca-certs bundle. Optional: when it is installed, its roots join the keychain's.
+pub const mavergreen_bundle_path = "/usr/local/mavergreen/ca-certs/etc/openssl/certs/ca-certificates.crt";
+
+/// Adds the PEM bundle at `path` to `cb`, all of it or none of it. An absent bundle adds nothing;
+/// one that cannot be read or parsed is skipped with one warning, leaving `cb` as it was.
+pub fn addMavergreenBundle(cb: *Bundle, gpa: Allocator, io: Io, now: Io.Timestamp, path: []const u8) void {
+    addPemBundle(cb, gpa, io, now, path) catch |err| switch (err) {
+        error.FileNotFound => {},
+        else => std.log.warn("skipping the ca-certs bundle {s}: {s}", .{ path, @errorName(err) }),
+    };
+}
+
+fn addPemBundle(cb: *Bundle, gpa: Allocator, io: Io, now: Io.Timestamp, path: []const u8) !void {
+    var file = try Io.Dir.cwd().openFile(io, path, .{});
+    defer file.close(io);
+    var file_reader = file.reader(io, &.{});
+
+    var extra: Bundle = .empty;
+    defer extra.deinit(gpa);
+    try extra.addCertsFromFile(gpa, &file_reader, now.toSeconds());
+    if (extra.map.count() == 0) return error.NoCertificates;
+
+    try cb.bytes.ensureUnusedCapacity(gpa, extra.bytes.items.len);
+    try cb.map.ensureUnusedCapacityContext(gpa, extra.map.count(), .{ .cb = cb });
+    var it = extra.map.valueIterator();
+    while (it.next()) |start| {
+        const cert = std.crypto.Certificate.der.Element.parse(extra.bytes.items, start.*) catch unreachable;
+        const cert_start: u32 = @intCast(cb.bytes.items.len);
+        cb.bytes.appendSliceAssumeCapacity(extra.bytes.items[start.*..cert.slice.end]);
+        cb.parseCert(gpa, cert_start, now.toSeconds()) catch unreachable;
+    }
+}
